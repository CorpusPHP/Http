{
	"name": "corpus/http",
	"description": "HTTP Status Codes and Exceptions",
	"type": "library",
	"license": "MIT",
	"authors": [
		{
			"name": "Jesse Donat",
			"email": "donatj@gmail.com"
		}
	],
	"require": {
		"php": "^8.2"
	},
	"autoload": {
		"psr-4": {
			"Corpus\\Http\\": "src/"
		}
	},
	"require-dev": {
		"corpus/coding-standard": "^0.10.0",
		"donatj/mddoc": "^0.14",
		"friendsofphp/php-cs-fixer": "^3.95",
		"phpstan/phpstan": "^2.3",
		"phpunit/phpunit": "^11.5",
		"squizlabs/php_codesniffer": "^4.0"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		},
		"platform": {
			"php": "8.2.0"
		}
	}
}
